# Sirius — server-side environment (invariant 15: secrets live here and
# nowhere else — never the repo, never the client bundle, never logs).

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Datastore — local: docker compose; staging/prod: shared ARES Mongo server, db "sirius"
MONGODB_URI=mongodb://localhost:27017/sirius
REDIS_URL=redis://localhost:6379

SESSION_SECRET=

# Google SSO (Passport) — four server-side checks; ALLOWED_HD is the hd claim
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_HD=frostdesigngroup.com

# ARES read API — READ-ONLY key class, server-side only (contracts/ares-read.md)
ARES_URL=https://ares.frostdesigngroup.com
ARES_API_KEY=

# Trello — THE one write path (urgency label). Dedicated integration account.
# Names match ARES's convention (TRELLO_WRITE_TOKEN also accepted).
TRELLO_API_KEY=
TRELLO_TOKEN=

# Sheets service account credential (JSON), provisioned as a server-side secret
GOOGLE_SHEETS_CREDENTIALS=
INTAKE_SHEET_IDS=

# Invariant 17 guardrail: production Trello board ids, comma-separated.
# Any non-production environment configured with one of these REFUSES to start.
PROD_TRELLO_BOARD_IDS=
