{
  "name": "sirius",
  "version": "0.1.0",
  "description": "Frost: Sirius — delivery pipeline & forecasting platform. Reads Trello (via ARES) and intake sheets; owns planning decisions only.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "tsx watch server.js",
    "start": "tsx server.js",
    "worker": "tsx worker/index.js",
    "build": "node frontend/build.js",
    "migrate": "tsx scripts/migrate/run.js",
    "seed": "tsx scripts/seed.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:tz": "TZ=UTC vitest run && TZ=Asia/Manila vitest run",
    "probe:ares": "node scripts/ares-probe.mjs"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "connect-redis": "^9.0.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ioredis": "^5.9.2",
    "mongoose": "^9.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "ractive": "^1.4.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
